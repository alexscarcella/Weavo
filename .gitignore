# OS / OneDrive noise
desktop.ini
Thumbs.db
.DS_Store

# Internal requirements/spec notes and local autosave backups — never version-controlled
requirements/
sample-data/backup/

# Claude Code local settings (contain machine-specific absolute paths)
.claude/

# Node (scripts/import-excel is a dev-time-only tool with its own deps)
node_modules/

# One-shot Excel import output: may contain a full real copy of project data — never version-controlled
import-output/

# Everything about the real Master Plan Excel import is private/local use only — the script,
# its config, and its output never go to the remote repo (only sample-data/'s fictional demo
# dataset does). Supersedes the node_modules/ and import-output/ rules above for this path, but
# those stay as-is since they also apply elsewhere.
scripts/import-excel/

# graphify knowledge graph — commit only the graph deliverables (HTML viz,
# GraphRAG JSON, plain-language report, manifest). Everything else
# (.graphify_* caches, cost.json, cache/, dated snapshot dirs) is regenerable
# via `graphify update .` and may embed excerpts of real data it indexed.
graphify-out/*
!graphify-out/graph.html
!graphify-out/graph.json
!graphify-out/GRAPH_REPORT.md
!graphify-out/manifest.json
